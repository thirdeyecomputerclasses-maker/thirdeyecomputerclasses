# Netlify HTTP Cache-Control Configuration for Third Eye
# Prevents bandwidth overuse and slashes repeat visitor requests to near-zero

# 1. Immutable Long-Term Caching for Vite Hashed JS, CSS, WebP, PNG, Fonts
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 2. Public Audio Files
/audio/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Accept-Ranges: bytes

# 3. Static SVGs & Icons
/favicon.svg
  Cache-Control: public, max-age=604800
/icons.svg
  Cache-Control: public, max-age=604800

# 4. Service Worker (Never cache sw.js so visitors receive updates instantly)
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# 5. Default HTML Pages & SPA Routes (Must revalidate to pick up latest deploy)
/*
  Cache-Control: public, max-age=0, must-revalidate
