# Backend API URL (Points to Express server on Render in production or localhost in development)
# Important: Do NOT include trailing "/api" or trailing slash.
# Example for local development:
# VITE_API_URL=http://localhost:5000
# Example for Render deployment:
# VITE_API_URL=https://third-eye-backend.onrender.com
VITE_API_URL=http://localhost:5000

# Clerk Authentication (Get this from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

