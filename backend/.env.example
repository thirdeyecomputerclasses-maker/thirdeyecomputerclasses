# Server Configuration
PORT=5000

# Frontend URL for CORS (e.g. http://localhost:5173 for local, or https://your-site.netlify.app on Render)
# Supports multiple comma-separated URLs: https://your-site.netlify.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Database Configuration (Required: MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/thirdeye?retryWrites=true&w=majority&appName=Cluster0

# ImageKit Configuration for CDN Image Uploads
# Obtain these from your ImageKit Dashboard: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
JWT_SECRET=

