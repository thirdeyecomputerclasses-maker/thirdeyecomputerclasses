# Server Configuration
PORT=5000

# Frontend URL for CORS (e.g. http://localhost:5173 for local, or https://your-site.netlify.app, https://thirdeyecomputerclasses.onrender.com)
# Supports multiple comma-separated URLs: https://your-site.netlify.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173,https://thirdeyecomputerclasses.onrender.com

# Database Configuration (Required: MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://thirdeyecomputerclasses_db_user:<password>@cluster0.d3vndw2.mongodb.net/thirdeye?retryWrites=true&w=majority

# ImageKit Configuration for CDN Image Uploads
# Obtain these from your ImageKit Dashboard: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/l9o8hinjo
JWT_SECRET=your_jwt_secret_key

